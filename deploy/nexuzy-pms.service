[Unit]
Description=Nexuzy PMS - Hotel & Property Operations System
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/nexuzy-pms
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=DB_PATH=/opt/nexuzy-pms/data/nexuzy.db

[Install]
WantedBy=multi-user.target
